# Discord Developer Portal → Bot → Token
TOKEN=your_discord_bot_token

# Discord Developer Portal → OAuth2
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/frostbyte

# Public URL of this app (Render → Env → your service URL)
BASE_URL=https://your-app.onrender.com

# Random string for session cookies
SESSION_SECRET=change_me_to_random_string

# Render sets PORT automatically; local default is 3000
# PORT=3000
