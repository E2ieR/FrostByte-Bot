    function addRrRoleRow() {
        const row = document.createElement('div');
        row.className = 'level-role-row';
        row.style.alignItems = 'center';
        row.innerHTML = `
            <input type="text" class="form-input rr-emoji" placeholder="Emoji (เช่น 🎮)" style="width:90px;text-align:center">
            <select class="form-input rr-role" style="flex:1">
                <option value="">— เลือก Role —</option>
                ${roleOptions()}
            </select>
            <input type="text" class="form-input rr-rdesc" placeholder="คำอธิบาย (ไม่บังคับ)" style="flex:1">
            <button class="btn btn-danger btn-sm" onclick="this.closest('.level-role-row').remove()">✕</button>`;
        document.getElementById('rr-roles-list').appendChild(row);
