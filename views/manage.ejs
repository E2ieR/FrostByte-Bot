    // ─── Save Join Roles ────────────────────────────────────
    async function saveJoinRoles(btn) {
        const status = document.getElementById('jr-save-status');
        btn.disabled = true;
        status.textContent = 'กำลังบันทึก…';
        status.style.color = 'var(--muted)';

        const joinRoles = [...document.querySelectorAll('#join-roles-list .level-role-row')].map(row => ({
            roleId: row.querySelector('.jr-role').value,
            roleName: row.querySelector('.jr-role').selectedOptions[0]?.text || '',
            delaySeconds: parseInt(row.querySelector('.jr-delay').value) || 0
        })).filter(r => r.roleId);

        const botJoinRoles = [...document.querySelectorAll('#bot-join-roles-list .level-role-row')].map(row => ({
            roleId: row.querySelector('.bjr-role').value,
            roleName: row.querySelector('.bjr-role').selectedOptions[0]?.text || ''
        })).filter(r => r.roleId);

        const payload = {
            joinRoles,
            botJoinRoles,
            stickyRolesEnabled: document.getElementById('ar-sticky').checked
        };

        try {
            const res  = await fetch(`/api/${GUILD_ID}/autorole/join`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'error');
            status.textContent = '✅ บันทึกแล้ว!';
            status.style.color = 'var(--green)';
        } catch (e) {
            status.textContent = '❌ ' + e.message;
            status.style.color = 'var(--red)';
        } finally {
            btn.disabled = false;
        }
    }

