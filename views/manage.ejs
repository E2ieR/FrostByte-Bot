    // ─── Create Reaction Group ──────────────────────────────
    async function createReactionGroup(btn) {
        const status = document.getElementById('rr-save-status');
        btn.disabled = true;
        status.textContent = 'กำลังส่ง…';
        status.style.color = 'var(--muted)';

        const roles = [...document.querySelectorAll('#rr-roles-list .level-role-row')].map(row => ({
            emoji:       row.querySelector('.rr-emoji').value.trim(),
            roleId:      row.querySelector('.rr-role').value,
            roleName:    row.querySelector('.rr-role').selectedOptions[0]?.text || '',
            description: row.querySelector('.rr-rdesc').value.trim()
        })).filter(r => r.emoji && r.roleId);

        const payload = {
            channelId:   document.getElementById('rr-channel').value,
            title:       document.getElementById('rr-title').value.trim() || 'เลือก Role',
            description: document.getElementById('rr-desc').value.trim(),
            color:       document.getElementById('rr-color').value,
            mode:        document.getElementById('rr-mode').value,
            roles
        };

        if (!payload.channelId) {
            status.textContent = '❌ กรุณาเลือก channel';
            status.style.color = 'var(--red)';
            btn.disabled = false;
            return;
        }
        if (!roles.length) {
            status.textContent = '❌ กรุณาเพิ่มอย่างน้อย 1 role';
            status.style.color = 'var(--red)';
            btn.disabled = false;
            return;
        }

        try {
            const res  = await fetch(`/api/${GUILD_ID}/autorole/group`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'error');
            status.textContent = '✅ ส่ง embed แล้ว! รีเฟรชหน้าเพื่อดู group';
            status.style.color = 'var(--green)';
            // Clear form
            document.getElementById('rr-title').value = '';
            document.getElementById('rr-desc').value = '';
            document.getElementById('rr-channel').value = '';
            document.getElementById('rr-roles-list').innerHTML = '';
        } catch (e) {
            status.textContent = '❌ ' + e.message;
            status.style.color = 'var(--red)';
        } finally {
            btn.disabled = false;
        }
    }

    // ═══════════════════════════════════════════════════════
    // COMMANDS TAB
    // ═══════════════════════════════════════════════════════
    let cmdGridLoaded = false;
    const CMD_DISABLED = <%- JSON.stringify(config.disabledCommands || []) %>;

    async function loadCommandGrid() {
        if (cmdGridLoaded) return;
        cmdGridLoaded = true;
        const container = document.getElementById('cmd-grid-container');
        try {
            const res = await fetch(`/api/${GUILD_ID}/commands-list`);
            const cmds = await res.json();

            const categories = {
                economy:  { label: '💰 เศรษฐกิจ',  cmds: [] },
                gambling: { label: '🎰 การพนัน',   cmds: [] },
                sports:   { label: '🏆 กีฬา',       cmds: [] },
                other:    { label: '🔧 อื่นๆ',       cmds: [] },
            };
            cmds.forEach(c => { if (categories[c.category]) categories[c.category].cmds.push(c); });

            let html = '';
            for (const [, cat] of Object.entries(categories)) {
                if (!cat.cmds.length) continue;
                html += `<div class="section-label" style="margin-top:16px">${cat.label}</div>`;
                html += '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:8px;margin-bottom:8px">';
                cat.cmds.forEach(c => {
                    const isEnabled = !CMD_DISABLED.includes(c.name);
                    html += `
                    <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:var(--surface2);border:1px solid var(--border);border-radius:8px">
                        <div>
                            <div style="font-weight:600;font-size:13px">${escHtml(c.label)}</div>
                            <div style="font-size:11px;color:var(--muted)">${escHtml(c.desc)}</div>
                        </div>
                        <label class="switch" style="flex-shrink:0;margin-left:10px">
                            <input type="checkbox" class="cmd-toggle-check" data-cmd="${c.name}" ${isEnabled ? 'checked' : ''}>
                            <span class="slider"></span>
                        </label>
                    </div>`;
                });
                html += '</div>';
            }

            container.innerHTML = html;
        } catch (e) {
            container.innerHTML = `<div style="color:var(--red)">❌ โหลดไม่สำเร็จ: ${e.message}</div>`;
        }
    }

    async function saveCommandSettings(btn) {
        const status = document.getElementById('cmd-save-status');
        btn.disabled = true;
        status.textContent = '⏳ กำลังบันทึก...';
        status.style.color = 'var(--muted)';

        const disabled = [...document.querySelectorAll('.cmd-toggle-check:not(:checked)')].map(i => i.dataset.cmd);

        try {
            const res = await fetch(`/api/${GUILD_ID}/commands`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ disabledCommands: disabled }),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error);
            status.textContent = '✅ บันทึกสำเร็จ!';
            status.style.color = 'var(--green)';
        } catch (err) {
            status.textContent = '❌ ' + err.message;
            status.style.color = 'var(--red)';
        } finally {
            btn.disabled = false;
            setTimeout(() => { status.textContent = ''; }, 4000);
        }
    }

    // ═══════════════════════════════════════════════════════
    // SPORTS TAB
    // ═══════════════════════════════════════════════════════
    let sportsChLoaded = false;

    async function loadSportsChannels() {
        if (sportsChLoaded) return;
        sportsChLoaded = true;
        try {
            const res = await fetch(`/api/${GUILD_ID}/sports-channels`);
            if (!res.ok) return;
            const channels = await res.json();

            const ids = ['sp-esp-channel', 'sp-f1-channel', 'sp-fb-channel'];
            const currents = {
                'sp-esp-channel': '<%= (sn && sn.esportsChannelId)  || "" %>',
                'sp-f1-channel':  '<%= (sn && sn.f1ChannelId)       || "" %>',
                'sp-fb-channel':  '<%= (sn && sn.footballChannelId) || "" %>',
            };

            for (const id of ids) {
                const sel = document.getElementById(id);
                if (!sel) continue;
                sel.innerHTML = '<option value="">— เลือกช่องข้อความ —</option>';
                channels.forEach(c => {
                    const o = document.createElement('option');
                    o.value = c.id;
                    o.textContent = '# ' + c.name;
                    if (c.id === currents[id]) o.selected = true;
                    sel.appendChild(o);
                });
            }
        } catch (e) { console.error('[Sports channels]', e); }
    }

    async function saveSportsSettings(btn) {
        const status = document.getElementById('sp-save-status');
        btn.disabled = true;
        status.textContent = '⏳ กำลังบันทึก...';
        status.style.color = 'var(--muted)';

        const esportsGames   = [...document.querySelectorAll('.sp-esp-game:checked')].map(c => c.value);
        const footballLeagues = [...document.querySelectorAll('.sp-fb-league:checked')].map(c => c.value);

        const payload = {
            esportsEnabled:      document.getElementById('sp-esp-enabled')?.checked,
            esportsChannelId:    document.getElementById('sp-esp-channel')?.value || '',
            esportsGames,
            esportsNotifyBefore: parseInt(document.getElementById('sp-esp-before')?.value) || 30,
            esportsTrackedTeams: {
                cs2:      document.getElementById('sp-esp-teams-cs2')?.value.split(',').map(t=>t.trim()).filter(Boolean),
                valorant: document.getElementById('sp-esp-teams-valorant')?.value.split(',').map(t=>t.trim()).filter(Boolean),
                lol:      document.getElementById('sp-esp-teams-lol')?.value.split(',').map(t=>t.trim()).filter(Boolean),
                mlbb:     document.getElementById('sp-esp-teams-mlbb')?.value.split(',').map(t=>t.trim()).filter(Boolean),
            },
            f1Enabled:      document.getElementById('sp-f1-enabled')?.checked,
            f1ChannelId:    document.getElementById('sp-f1-channel')?.value || '',
            f1NotifyBefore: parseInt(document.getElementById('sp-f1-before')?.value) || 60,
            f1NotifyLive:   document.getElementById('sp-f1-live')?.checked,
            footballEnabled:      document.getElementById('sp-fb-enabled')?.checked,
            footballChannelId:    document.getElementById('sp-fb-channel')?.value || '',
            footballLeagues,
            footballTeams:        document.getElementById('sp-fb-teams')?.value || '',
            footballNotifyBefore: parseInt(document.getElementById('sp-fb-before')?.value) || 30,
            footballNotifyLive:   document.getElementById('sp-fb-live')?.checked,
            footballNotifyLineup: document.getElementById('sp-fb-lineup')?.checked,
        };

        try {
            const res  = await fetch(`/api/${GUILD_ID}/sports`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'บันทึกไม่สำเร็จ');
            status.textContent = '✅ บันทึกสำเร็จแล้ว!';
            status.style.color = 'var(--green)';
        } catch (err) {
            status.textContent = '❌ ' + err.message;
            status.style.color = 'var(--red)';
        } finally {
            btn.disabled = false;
            setTimeout(() => { status.textContent = ''; }, 4000);
        }
    }

    // ─── Delete Group ───────────────────────────────────────
    async function deleteGroup(groupId) {
        if (!confirm('ลบ group นี้? ข้อความบอทในช่องจะถูกลบด้วย')) return;
        try {
            const res = await fetch(`/api/${GUILD_ID}/autorole/group/${groupId}`, { method: 'DELETE' });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'error');
            document.querySelector(`[data-group-id="${groupId}"]`)?.remove();
        } catch (e) {
            alert('❌ ' + e.message);
        }
    }

    // ─── Resend Group embed ─────────────────────────────────
    async function resendGroup(groupId) {
        if (!confirm('ส่ง embed ใหม่? ข้อความเก่าจะถูกลบ')) return;
        try {
            const res  = await fetch(`/api/${GUILD_ID}/autorole/group/${groupId}/resend`, { method: 'POST' });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'error');
            alert('✅ ส่ง embed ใหม่แล้ว (message ID: ' + data.messageId + ')');
        } catch (e) {
            alert('❌ ' + e.message);
        }
    }
</script>
</body>
</html>
