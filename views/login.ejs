<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FrostByte Dashboard — <%= tr('เข้าสู่ระบบ') %></title>
    <script><%- i18nBootstrap() %></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg:        #0a1120;
            --surface:   #101a30;
            --border:    #1e2d4a;
            --blurple:   #38bdf8;
            --blurple-h: #0284c7;
            --text:      #e2f0ff;
            --muted:     #7c93b8;
            --accent-glow: rgba(56,189,248,0.25);
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        /* ambient glow in background */
        body::before {
            content: '';
            position: fixed;
            top: -200px; left: 50%;
            transform: translateX(-50%);
            width: 700px; height: 500px;
            background: radial-gradient(ellipse, rgba(56,189,248,0.12) 0%, transparent 70%);
            pointer-events: none;
        }

        .wrap {
            position: relative;
            width: 100%;
            max-width: 400px;
            padding: 20px;
        }

        /* floating orbs */
        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
            animation: drift 12s ease-in-out infinite alternate;
        }
        .orb-1 { width:300px;height:300px; background:rgba(56,189,248,0.15); top:-80px; right:-80px; animation-delay:0s; }
        .orb-2 { width:200px;height:200px; background:rgba(34,211,238,0.10); bottom:60px; left:-60px; animation-delay:-4s; }
        @keyframes drift { from{transform:translate(0,0)} to{transform:translate(20px,30px)} }

        .card {
            background: var(--surface);
            border: 1px solid rgba(56,189,248,0.3);
            border-radius: 16px;
            padding: 44px 40px;
            text-align: center;
            box-shadow: 0 0 0 1px rgba(56,189,248,0.08), 0 8px 40px rgba(56,189,248,0.12);
        }

        .logo {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 60px; height: 60px;
            background: linear-gradient(135deg, var(--blurple), #7dd3fc);
            border-radius: 16px;
            font-size: 28px;
            margin-bottom: 24px;
            animation: pulse-logo 3s ease-in-out infinite;
            box-shadow: 0 0 20px rgba(56,189,248,0.4);
        }

        @keyframes pulse-logo {
            0%, 100% { box-shadow: 0 0 20px rgba(56,189,248,0.4); }
            50% { box-shadow: 0 0 32px rgba(56,189,248,0.7), 0 0 48px rgba(56,189,248,0.25); }
        }

        h1 {
            font-size: 22px;
            font-weight: 700;
            letter-spacing: -0.3px;
            margin-bottom: 8px;
        }

        p {
            color: var(--muted);
            font-size: 14px;
            line-height: 1.6;
            margin-bottom: 32px;
        }

        .btn-discord {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: linear-gradient(135deg, var(--blurple) 0%, #7dd3fc 100%);
            color: #fff;
            text-decoration: none;
            padding: 13px 20px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 15px;
            transition: background 0.15s, transform 0.1s, box-shadow 0.15s;
            box-shadow: 0 4px 16px rgba(56,189,248,0.35);
        }
        .btn-discord:hover { background: linear-gradient(135deg, var(--blurple-h) 0%, var(--blurple) 100%); transform: translateY(-1px); box-shadow: 0 6px 24px rgba(56,189,248,0.5); }
        .btn-discord:active { transform: translateY(0); }

        .btn-discord svg { flex-shrink: 0; }

        .footer {
            margin-top: 28px;
            font-size: 12px;
            color: var(--muted);
        }
        .footer a { color: var(--muted); text-decoration: underline; }

        .features {
            display: flex;
            gap: 10px;
            margin-top: 28px;
            text-align: left;
        }
        .feature {
            flex: 1;
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px 14px;
        }
        .feature .icon { font-size: 18px; margin-bottom: 6px; }
        .feature .label { font-size: 11px; font-weight: 600; color: var(--text); }
        .feature .desc { font-size: 11px; color: var(--muted); margin-top: 2px; }
    </style>
</head>
<body>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>

    <div class="wrap">
        <div class="card">
            <div class="logo">🤖</div>
            <h1>FrostByte Dashboard</h1>
            <p><%= tr('จัดการเซิร์ฟเวอร์ Discord ของคุณ') %><br><%= tr('ระบบ Economy, Store, Betting และอีกมากมาย') %></p>

            <a href="<%= authorizeUrl %>" class="btn-discord">
                <svg width="20" height="20" viewBox="0 0 127.14 96.36" fill="white" xmlns="http://www.w3.org/2000/svg">
                    <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"/>
                </svg>
                <%= tr('เข้าสู่ระบบด้วย Discord') %>
            </a>

            <div class="features">
                <div class="feature">
                    <div class="icon">💰</div>
                    <div class="label">Economy</div>
                    <div class="desc"><%= tr('สกุลเงิน, งาน, ยศ') %></div>
                </div>
                <div class="feature">
                    <div class="icon">🛒</div>
                    <div class="label">Store</div>
                    <div class="desc"><%= tr('ร้านค้าและไอเทม') %></div>
                </div>
                <div class="feature">
                    <div class="icon">🎲</div>
                    <div class="label">Betting</div>
                    <div class="desc"><%= tr('ระบบเดิมพัน') %></div>
                </div>
            </div>

            <div class="footer">
                <%= tr('เข้าสู่ระบบด้วยบัญชี Discord ที่มีสิทธิ์ Admin เท่านั้น') %>
            </div>

            <div style="margin-top:14px;display:flex;gap:8px;justify-content:center">
                <a href="/lang/en?back=/" class="<%= lang==='en'?'':'' %>" style="font-size:11px;padding:4px 10px;border-radius:6px;border:1px solid <%= lang==='en' ? 'var(--blurple)' : 'var(--border)' %>;color:<%= lang==='en' ? 'var(--blurple)' : 'var(--muted)' %>;text-decoration:none;background:<%= lang==='en' ? 'rgba(56,189,248,0.12)' : 'transparent' %>">EN</a>
                <a href="/lang/th?back=/" style="font-size:11px;padding:4px 10px;border-radius:6px;border:1px solid <%= lang==='th' ? 'var(--blurple)' : 'var(--border)' %>;color:<%= lang==='th' ? 'var(--blurple)' : 'var(--muted)' %>;text-decoration:none;background:<%= lang==='th' ? 'rgba(56,189,248,0.12)' : 'transparent' %>">TH</a>
            </div>
        </div>
    </div>
</body>
</html>
